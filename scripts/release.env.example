# Copiá este archivo a release.env.local (misma carpeta) y completá los valores.
# release.env.local está en .gitignore — no se sube a GitHub.
#
#   cp scripts/release.env.example scripts/release.env.local
#
# Opción A (recomendada): perfil en el Llavero de macOS (sin contraseña en disco)
#   xcrun notarytool store-credentials "Slots-Notary" \
#     --apple-id "tu@email.com" \
#     --team-id "53M8KYX8G4" \
#     --password "xxxx-xxxx-xxxx-xxxx"
# NOTARY_KEYCHAIN_PROFILE="Slots-Notary"
#
# Opción B: variables en este archivo (entre comillas si hay caracteres raros)
# NOTARY_APPLE_ID="tu@email.com"
# NOTARY_TEAM_ID="53M8KYX8G4"
# NOTARY_PASSWORD="app-specific-password"
#
# Opcional (el script autodetecta el certificado si no lo ponés):
# DEVELOPER_ID="Developer ID Application: Tu Nombre (53M8KYX8G4)"
# DEVELOPMENT_TEAM="53M8KYX8G4"
